{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./*"]
    },
    "types": ["node", "react"],
    "allowImportingTsExtensions": true
  },
  "exclude": [
    "node_modules",
    "dist",
    "dist-native",
    "test-results",
    "playwright-report",
    ".expo",
    ".impeccable"
  ]
}
