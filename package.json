{
  "name": "rabbit",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo/html-elements": "^0.12.5",
    "@expo/metro-runtime": "~58.0.15",
    "@gluestack-ui/core": "^5.0.15",
    "@gluestack-ui/utils": "^5.0.6",
    "@legendapp/motion": "^2.5.3",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "babel-preset-expo": "~58.0.0",
    "expo": "~58.0.21",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-font": "~58.0.11",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "lucide-react-native": "^1.65.0",
    "react": "19.3.0",
    "react-aria": "^3.53.1",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "^15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "react-stately": "^3.51.0",
    "tailwind-variants": "^0.1.20",
    "uniwind": "^1.13.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "bcryptjs": "^3.0.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "node scripts/dev.mjs",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "node scripts/dev.mjs",
    "expo:start": "expo start",
    "api": "node server/index.ts",
    "test": "node --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:firebase": "RUN_FIREBASE_TESTS=1 node --env-file=.env.local --test tests/firebase.test.ts",
    "test:e2e:firebase": "RABBIT_E2E_FIREBASE=1 playwright test tests/e2e/firebase.spec.ts",
    "firebase:seed": "node scripts/seed-firebase.mjs",
    "firebase:deploy": "firebase deploy --only auth,firestore --non-interactive",
    "typecheck": "tsc --noEmit",
    "build:web": "expo export --platform web",
    "serve": "SERVE_WEB=1 node server/index.ts",
    "preview:web": "npm run build:web && SERVE_WEB=1 PORT=4173 DB_PATH=data/preview.sqlite node server/index.ts",
    "format": "prettier --write App.tsx src server tests scripts *.json *.js *.css *.ts",
    "test:rules": "firebase emulators:exec --config firebase.emulators.json --project demo-rabbit-friends --only auth,firestore \"node --test tests/firebase-*.test.ts\""
  },
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  }
}
