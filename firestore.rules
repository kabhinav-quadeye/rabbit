rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function member(groupId) {
      return signedIn() && me() in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }
    function canRead(post) {
      return signedIn() && (post.authorId == me()
        || (post.audienceType == 'user' && post.audienceId == me())
        || (post.audienceType == 'group' && member(post.audienceId)));
    }
    function text(value, limit) { return value is string && value.size() <= limit; }
    function validUser(user, uid) {
      return user.keys().hasAll(['id', 'name', 'handle', 'bio', 'color'])
        && user.keys().hasOnly(['id', 'name', 'handle', 'bio', 'color', 'avatar'])
        && user.id == uid && text(user.name, 60) && user.name.size() > 0
        && user.handle is string && user.handle.matches('[a-z0-9][a-z0-9._-]{2,39}')
        && getAfter(/databases/$(database)/documents/usernames/$(user.handle)).data.userId == uid
        && text(user.bio, 240) && user.color in ['sage', 'peach', 'lavender', 'blue', 'sand']
        && (!('avatar' in user) || (text(user.avatar, 2000) && user.avatar.matches('https://.*')));
    }
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && me() == uid && validUser(request.resource.data, uid);
      allow update: if signedIn() && me() == uid && validUser(request.resource.data, uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'bio', 'avatar', 'color']);
      allow delete: if signedIn() && me() == uid;
    }
    match /usernames/{handle} {
      allow get: if true;
      allow list: if signedIn();
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['userId'])
        && request.resource.data.userId == me()
        && getAfter(/databases/$(database)/documents/users/$(me())).data.handle == handle;
    }
    function validRequest(r, requestId) {
      return r.keys().hasAll(['id', 'senderId', 'recipientId', 'status'])
        && r.keys().hasOnly(['id', 'senderId', 'recipientId', 'status'])
        && r.id == requestId && requestId == r.senderId + ':' + r.recipientId
        && r.senderId != r.recipientId
        && exists(/databases/$(database)/documents/users/$(r.senderId))
        && exists(/databases/$(database)/documents/users/$(r.recipientId));
    }
    function noReverse(r) {
      let reverse = /databases/$(database)/documents/friendRequests/$(r.recipientId + ':' + r.senderId);
      return !exists(reverse) || get(reverse).data.status == 'declined';
    }
    function indexed(r) {
      return r.recipientId in getAfter(/databases/$(database)/documents/friendLists/$(r.senderId)).data.ids
        && r.senderId in getAfter(/databases/$(database)/documents/friendLists/$(r.recipientId)).data.ids;
    }
    match /friendRequests/{requestId} {
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/friendRequests/$(requestId))
        || me() in [resource.data.senderId, resource.data.recipientId]);
      allow list: if signedIn() && (resource.data.senderId == me() || resource.data.recipientId == me());
      allow create: if signedIn() && validRequest(request.resource.data, requestId)
        && request.resource.data.senderId == me() && request.resource.data.status == 'pending'
        && noReverse(request.resource.data);
      allow update: if signedIn() && validRequest(request.resource.data, requestId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && ((resource.data.status == 'pending' && resource.data.recipientId == me()
            && (request.resource.data.status == 'declined'
              || (request.resource.data.status == 'accepted' && indexed(resource.data))))
          || (resource.data.status == 'declined' && resource.data.senderId == me()
            && request.resource.data.status == 'pending' && noReverse(resource.data)));
    }
    function validFriendList(uid, previous) {
      let next = request.resource.data;
      let r = getAfter(/databases/$(database)/documents/friendRequests/$(next.requestId)).data;
      let other = uid == r.senderId ? r.recipientId : r.senderId;
      return next.keys().hasAll(['ids', 'requestId']) && next.keys().hasOnly(['ids', 'requestId'])
        && r.status == 'accepted' && me() == r.recipientId && uid in [r.senderId, r.recipientId]
        && next.ids is list && next.ids.toSet().size() == next.ids.size()
        && other in next.ids && next.ids.hasAll(previous)
        && next.ids.toSet().difference(previous.toSet()).hasOnly([other]);
    }
    match /friendLists/{uid} {
      allow get: if signedIn() && (me() == uid
        || get(/databases/$(database)/documents/friendRequests/$(uid + ':' + me())).data.status == 'pending');
      allow create: if signedIn() && validFriendList(uid, []);
      allow update: if signedIn() && validFriendList(uid, resource.data.ids);
    }
    function onlyFriends(ids) {
      return ids.hasOnly([me()])
        || ids.difference([me()].toSet()).hasOnly(get(/databases/$(database)/documents/friendLists/$(me())).data.ids);
    }
    function validGroup(group, groupId) {
      return group.keys().hasAll(['id', 'name', 'description', 'ownerId', 'memberIds', 'color', 'icon'])
        && group.keys().hasOnly(['id', 'name', 'description', 'ownerId', 'memberIds', 'color', 'icon'])
        && group.id == groupId && text(group.name, 60) && group.name.size() > 0
        && text(group.description, 300) && group.memberIds is list
        && group.memberIds.size() > 0 && group.memberIds.size() <= 100
        && group.memberIds.toSet().size() == group.memberIds.size()
        && group.ownerId in group.memberIds
        && group.color in ['sage', 'peach', 'lavender', 'blue', 'sand']
        && group.icon in ['users', 'palette', 'blocks', 'book'];
    }
    match /groups/{groupId} {
      allow read: if signedIn() && me() in resource.data.memberIds;
      allow create: if signedIn() && request.resource.data.ownerId == me()
        && me() in request.resource.data.memberIds && validGroup(request.resource.data, groupId)
        && onlyFriends(request.resource.data.memberIds.toSet());
      allow update: if signedIn() && me() in resource.data.memberIds
        && validGroup(request.resource.data, groupId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
        && request.resource.data.memberIds.hasAll(resource.data.memberIds)
        && onlyFriends(request.resource.data.memberIds.toSet().difference(resource.data.memberIds.toSet()));
      allow delete: if signedIn() && resource.data.ownerId == me();
    }
    function validPost(post, postId) {
      return post.keys().hasAll(['id', 'authorId', 'audienceType', 'audienceId', 'title', 'body', 'tags', 'type', 'createdAt', 'votes', 'savedBy', 'comments'])
        && post.keys().hasOnly(['id', 'authorId', 'audienceType', 'audienceId', 'title', 'body', 'tags', 'type', 'url', 'createdAt', 'votes', 'savedBy', 'comments', 'outdatedBy'])
        && post.id == postId && text(post.title, 180) && post.title.size() > 0
        && text(post.body, 20000) && post.tags is list && post.tags.size() <= 6
        && post.type in ['note', 'link', 'question'] && text(post.createdAt, 40)
        && (post.type != 'link' || (text(post.url, 2000) && post.url.matches('https?://.*')))
        && post.votes is list && post.savedBy is list && post.comments is list
        && post.get('outdatedBy', []) is list;
    }
    function ownToggle(previous, next) {
      return next is list && next.toSet().size() == next.size()
        && next.toSet().difference(previous.toSet()).hasOnly([me()])
        && previous.toSet().difference(next.toSet()).hasOnly([me()]);
    }
    function newComment(previous, next) {
      let last = next[next.size() - 1];
      return next.size() == previous.size() + 1
        && next.removeAll([last]) == previous
        && last.keys().hasAll(['id', 'authorId', 'body', 'createdAt'])
        && last.keys().hasOnly(['id', 'authorId', 'body', 'createdAt'])
        && text(last.id, 100) && last.id.size() > 0 && last.authorId == me()
        && text(last.body, 4000) && last.body.size() > 0 && text(last.createdAt, 40);
    }
    match /posts/{postId} {
      allow read: if canRead(resource.data);
      allow create: if signedIn() && request.resource.data.authorId == me()
        && validPost(request.resource.data, postId)
        && request.resource.data.votes.size() == 0
        && request.resource.data.savedBy.size() == 0
        && request.resource.data.comments.size() == 0
        && request.resource.data.get('outdatedBy', []).size() == 0
        && ((request.resource.data.audienceType == 'self' && request.resource.data.audienceId == me())
          || (request.resource.data.audienceType == 'user' && exists(/databases/$(database)/documents/users/$(request.resource.data.audienceId)))
          || (request.resource.data.audienceType == 'group' && member(request.resource.data.audienceId)));
      allow update: if canRead(resource.data) && validPost(request.resource.data, postId)
        && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes'])
            && ownToggle(resource.data.votes, request.resource.data.votes))
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['savedBy'])
            && ownToggle(resource.data.savedBy, request.resource.data.savedBy))
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['outdatedBy'])
            && ownToggle(resource.data.get('outdatedBy', []), request.resource.data.get('outdatedBy', [])))
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments'])
            && newComment(resource.data.comments, request.resource.data.comments)));
      allow delete: if signedIn() && resource.data.authorId == me();
    }
    // Goals are private to their members: the owner plus anyone they share
    // with. Goals from before sharing have no memberIds and belong to their
    // owner alone. Members work on tasks; only the owner changes settings.
    // Domain code keeps the cascade invariant (a done task has no open
    // descendants); rules enforce privacy, structure and immutable fields.
    function calendarDate(value) {
      return value == null || (value is string && value.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'));
    }
    function stamp(value) { return value is string && value.size() > 0 && value.size() <= 40; }
    function goalMemberIds(g) { return g.get('memberIds', [g.ownerId]); }
    function inGoal(g) { return g.ownerId == me() || me() in g.get('memberIds', []); }
    function goalOf(goalId) { return get(/databases/$(database)/documents/goals/$(goalId)).data; }
    function validGoal(g, goalId) {
      return g.keys().hasAll(['id', 'ownerId', 'title', 'why', 'color', 'icon', 'targetDate', 'status', 'createdAt', 'updatedAt', 'reachedAt'])
        && g.keys().hasOnly(['id', 'ownerId', 'title', 'why', 'color', 'icon', 'targetDate', 'status', 'createdAt', 'updatedAt', 'reachedAt', 'memberIds'])
        && (!('memberIds' in g) || (g.memberIds is list && g.memberIds.size() > 0
          && g.memberIds.size() <= 50 && g.memberIds.toSet().size() == g.memberIds.size()
          && g.ownerId in g.memberIds))
        && g.id == goalId && text(g.title, 120) && g.title.size() > 0 && text(g.why, 500)
        && g.color in ['sage', 'peach', 'lavender', 'blue', 'sand']
        && g.icon in ['run', 'book', 'leaf', 'language', 'flag', 'heart']
        && calendarDate(g.targetDate) && g.status in ['active', 'reached', 'archived']
        && stamp(g.createdAt) && stamp(g.updatedAt) && (g.reachedAt == null || stamp(g.reachedAt));
    }
    function goalSettingsEdit() {
      return resource.data.ownerId == me()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['title', 'why', 'color', 'icon', 'targetDate', 'status', 'updatedAt', 'reachedAt']);
    }
    // Members invite their own accepted friends, as in circles. The owner can
    // remove anyone except themself; any other member can leave.
    function goalMembersEdit() {
      let before = goalMemberIds(resource.data);
      let after = request.resource.data.memberIds;
      return inGoal(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
        && ((after.hasAll(before) && onlyFriends(after.toSet().difference(before.toSet())))
          || (before.hasAll(after) && (resource.data.ownerId == me()
            || before.toSet().difference(after.toSet()) == [me()].toSet())));
    }
    match /goals/{goalId} {
      allow read: if signedIn() && inGoal(resource.data);
      allow create: if signedIn() && request.resource.data.ownerId == me()
        && validGoal(request.resource.data, goalId)
        && onlyFriends(goalMemberIds(request.resource.data).toSet());
      allow update: if signedIn() && validGoal(request.resource.data, goalId)
        && (goalSettingsEdit() || goalMembersEdit());
      allow delete: if signedIn() && resource.data.ownerId == me();
    }
    function validTask(t, taskId) {
      return t.keys().hasAll(['id', 'ownerId', 'goalId', 'parentId', 'depth', 'description', 'notes', 'priority', 'dueDate', 'status', 'createdAt', 'updatedAt', 'completedAt'])
        && t.keys().hasOnly(['id', 'ownerId', 'goalId', 'parentId', 'depth', 'description', 'notes', 'priority', 'dueDate', 'status', 'createdAt', 'updatedAt', 'completedAt', 'completedBy'])
        && (t.get('completedBy', null) == null || t.completedBy is string)
        && t.id == taskId && t.goalId is string && (t.parentId == null || t.parentId is string)
        && t.depth is int && t.depth >= 0 && t.depth <= 3
        && text(t.description, 500) && t.description.size() > 0 && text(t.notes, 10000)
        && t.priority in ['none', 'low', 'medium', 'high'] && calendarDate(t.dueDate)
        && t.status in ['open', 'done'] && stamp(t.createdAt) && stamp(t.updatedAt)
        && ((t.status == 'open' && t.completedAt == null) || (t.status == 'done' && stamp(t.completedAt)));
    }
    function validParent(t) {
      let parent = getAfter(/databases/$(database)/documents/goalTasks/$(t.parentId)).data;
      return parent.ownerId == t.ownerId && parent.goalId == t.goalId && t.depth == parent.depth + 1;
    }
    // Tasks carry the goal owner's id whoever adds them, so the owner's single
    // ownerId query loads every task, and members reach tasks through the goal.
    function taskMember(t) { return t.ownerId == me() || inGoal(goalOf(t.goalId)); }
    function newTaskInGoal(t) {
      let g = goalOf(t.goalId);
      return inGoal(g) && t.ownerId == g.ownerId;
    }
    // Only the person completing a task can record themself as its completer.
    function validCompleter(before, after) {
      return after.get('completedBy', null) == null
        || after.completedBy == before.get('completedBy', null)
        || after.completedBy == me();
    }
    match /goalTasks/{taskId} {
      allow read: if signedIn() && taskMember(resource.data);
      allow create: if signedIn() && validTask(request.resource.data, taskId)
        && request.resource.data.status == 'open'
        && request.resource.data.get('completedBy', null) == null
        && newTaskInGoal(request.resource.data)
        && (request.resource.data.parentId == null
          ? request.resource.data.depth == 0
          : validParent(request.resource.data));
      allow update: if signedIn() && taskMember(resource.data)
        && validTask(request.resource.data, taskId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['description', 'notes', 'priority', 'dueDate', 'status', 'updatedAt', 'completedAt', 'completedBy'])
        && validCompleter(resource.data, request.resource.data);
      allow delete: if signedIn() && taskMember(resource.data);
    }
  }
}
